# Copy to .env and adjust. Never commit .env.
#
# Every setting below is declared in src/kai/config.py. Nothing in this file is
# read by the code directly; pydantic-settings reads it. The Docker Compose
# stack reads the same variable names from your shell or this file.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# "development" | "test" | "production"
#
# production is a fail-closed mode: the app refuses to start if either secret
# below is still at its shipped default, or if GOOGLE_CREDS_ENCRYPTION_SECRET is
# shorter than 32 characters. That check is in config.py and is verified in CI.
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# asyncpg dialect, used by the application and by alembic.
DATABASE_URL=postgresql+asyncpg://kai:kai@127.0.0.1:5432/kai

# Postgres container settings (docker compose service "db").
POSTGRES_USER=kai
POSTGRES_PASSWORD=kai
POSTGRES_DB=kai
POSTGRES_PORT=5432

# Port the application is published on by docker compose.
APP_PORT=8000

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Must be a long random string (32+ characters; production refuses anything
# shorter). Replace this placeholder before any deployment.
JWT_SECRET=replace-with-a-long-random-string
JWT_ACCESS_TOKEN_MINUTES=120

# Signing algorithm and token audience/issuer. The allowlist is closed to
# HS256/384/512; production refuses "none" or any asymmetric algorithm, because
# this service signs with a shared symmetric secret. Change these only if you
# are retiring tokens or moving the service behind a new hostname.
# JWT_ALGORITHM=HS256
# JWT_ISSUER=kai
# JWT_AUDIENCE=kai-api
# JWT_LEEWAY_SECONDS=5

# ---------------------------------------------------------------------------
# Rate limiting (unauthenticated /auth/login and /auth/register)
# ---------------------------------------------------------------------------
# Production REFUSES TO START unless the backend is redis. The in-memory store
# counts per process, so behind a load balancer a client gets the limit once
# per replica; that is not a limit. "auto" picks redis when REDIS_URL is set and
# memory otherwise, which is only ever correct for a single-process run.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_BACKEND=auto
# REDIS_URL=redis://redis:6379/0
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# CORS and trusted hosts
# ---------------------------------------------------------------------------
# Empty CORS_ALLOWED_ORIGINS means no cross-origin browser access at all, which
# is the right default for a non-browser API. Set it only if a web client on
# another origin calls this API, and list exact origins. "*" is refused in
# production because it is incompatible with credentialed requests.
# CORS_ALLOWED_ORIGINS=["https://app.example"]

# Requests whose Host header is not in this list get 400. Empty disables the
# check. Set it to the hostname this service is actually served on so a
# poisoned Host cannot be reflected into generated URLs.
# TRUSTED_HOSTS=["api.example.com"]

# ---------------------------------------------------------------------------
# Google OAuth
# ---------------------------------------------------------------------------
# From the Google Cloud console, an OAuth 2.0 Client ID. Left empty, the
# connect endpoint refuses rather than sending the user to a broken consent URL.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Must match a redirect URI registered on that OAuth client exactly, including
# scheme, host, port and path.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Encrypts stored Google refresh tokens at rest (Fernet key derivation).
# Must be 32+ random bytes. Production refuses to start otherwise.
GOOGLE_CREDS_ENCRYPTION_SECRET=replace-with-32-plus-random-bytes

# Scopes are least-privilege by default. Override only with a deliberate
# decision; the defaults are already the narrowest set each provider path needs.
# GOOGLE_OAUTH_SCOPES=openid email
# GOOGLE_CONTACTS_SCOPE=https://www.googleapis.com/auth/contacts.readonly
# GOOGLE_CALENDAR_SCOPE=https://www.googleapis.com/auth/calendar.events
# GOOGLE_GMAIL_READ_SCOPE=https://www.googleapis.com/auth/gmail.readonly
# GOOGLE_GMAIL_SEND_SCOPE=https://www.googleapis.com/auth/gmail.send
# GOOGLE_OAUTH_ACCESS_TOKEN_MINUTES=60

# ---------------------------------------------------------------------------
# Planner model (OpenAI-compatible /chat/completions endpoint)
# ---------------------------------------------------------------------------
# Empty PLANNER_MODEL_URL means the provider refuses to run. Tests never hit the
# network; they inject a deterministic stub.
PLANNER_MODEL=kai-planner-v0.5
PLANNER_MODEL_URL=
PLANNER_MODEL_API_KEY=
PLANNER_MODEL_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# METRICS_ENABLED turns on the Prometheus endpoint. It is OFF by default because
# the endpoint is unauthenticated: Prometheus cannot present a KAI token, so
# serving it is an exposure decision rather than a default. When it is on, the
# route must be reachable only from a private network or through a scrape proxy
# that authenticates callers itself. Enabling it here does not bind it publicly;
# docker-compose.yml does not publish the port.
# METRICS_ENABLED=false
#
# Path the metrics endpoint is served on. Change it only if the whole scrape
# configuration moves with it; it is part of the scrape target, not a secret.
# METRICS_PATH=/api/v1/metrics

# TRACING_ENABLED turns on request spans. Spans are emitted as JSON log records
# (event "span_ended"), not to a collector, so there is no exporter to configure
# and no agent to run. Ingest them with your log pipeline's span parsing.
# TRACING_ENABLED=true
#
# TRACING_ACCEPT_INBOUND parses a W3C traceparent header from the caller so a
# trace continues across services. OFF by default: this service emits its own
# root span, and honouring an untrusted header would let any client attach its
# ids to this service's spans.
# TRACING_ACCEPT_INBOUND=false
#
# Fraction of requests that get a span, 0.0 to 1.0. Sampling is per request id,
# so a decision is stable across the retries of one request.
# TRACING_SAMPLE_RATIO=1.0

# ---------------------------------------------------------------------------
# Memory
# ---------------------------------------------------------------------------
# Lifetime for each TTL level when the caller does not name one. PERMANENT
# entries never expire and have no setting here.
#
# Freshness is separate from lifetime and is decayed from updated_at with an
# injectable clock. It ranks retrieval; it never grants anything. Memory cannot
# change policy, permissions, approvals or identity at any TTL.
# MEMORY_LONG_TTL_DAYS=365
# MEMORY_SHORT_TTL_DAYS=30
# MEMORY_EPHEMERAL_HOURS=24
# MEMORY_FRESHNESS_HALF_LIFE_DAYS=14

# ---------------------------------------------------------------------------
# Approvals
# ---------------------------------------------------------------------------
# Every approval is time-boxed. A PENDING or APPROVED request past this
# expiration is lazy-expired and never authorizes, so raising this value widens
# the window in which an old approval can still be spent.
# APPROVAL_TTL_MINUTES=1440
#
# Approval fatigue: this many approvals for the same (tool, risk, recipient
# class) inside the window produce ONE rule suggestion. That suggestion is a
# non-authorizing proposal. Rejecting it starts the cooldown, and no suggestion
# ever grants permission by itself.
# APPROVAL_FATIGUE_THRESHOLD=5
# APPROVAL_FATIGUE_WINDOW_DAYS=14
# APPROVAL_FATIGUE_COOLDOWN_DAYS=30
#
# How long an undecided fatigue suggestion is offered before it is retired.
# APPROVAL_SUGGESTION_EXPIRATION_DAYS=30

# ---------------------------------------------------------------------------
# Application identity
# ---------------------------------------------------------------------------
# Service name, used as the FastAPI title. Cosmetic; change it if the API is
# published under a different name in a gateway or developer portal.
# APP_NAME=KAI

# ---------------------------------------------------------------------------
# Scheduler
# ---------------------------------------------------------------------------
# The purge schedule is NOT configured here. The application never owns a timer:
# an external scheduler runs deploy/scheduler/run-purge-revocations.sh every 15
# minutes and the process exits. See deploy/scheduler/kai.cron.
#
# These two variables are read by that script, not by KAI.
#
# Hard ceiling on one purge run. The purge is a single DELETE of already-expired
# rows; anything approaching this is a stuck connection, not a large table. The
# bound exists so a wedged database cannot outlive its window and overlap the
# next one.
# KAI_PURGE_TIMEOUT_SECONDS=120
#
# The Compose project the deployment runs under. The purge must reach the same
# database as the running app; a mismatch purges a different, empty stack and
# exits 0, which looks like success.
# KAI_COMPOSE_PROJECT_NAME=kai

# ---------------------------------------------------------------------------
# Alerting
# ---------------------------------------------------------------------------
# There are two different things called "alerting" here, and they are not
# alternatives to each other.
#
# 1. Metrics-based alerts. The rules live in deploy/alerting/ and are loaded by
#    a Prometheus that already scrapes METRICS_PATH. They watch the *service*
#    (is it up, is the database reachable, are errors spiking). Wiring and
#    thresholds are in docs/ALERTING.md. KAI ships no monitoring stack.
#
# 2. Execution alerts (below). KAI pushes these itself, because a Prometheus
#    cannot know that one specific task failed - it only sees counters.
#
# --- 2. Execution alerts: an external destination for task failures ---------
# When a task's durable state enters an unresolved failure, KAI POSTs one JSON
# alert to the URL below, and POSTs a second one when that failure is later
# resolved. Nothing else is sent, and no task content is: the payload carries
# the task id, tenant id, the two states either side of the edge, the sealed
# fulfillment profile and the retry counters, and nothing else - never the goal,
# never the error text, never this URL.
#
# Off by default. Setting the URL alone sends nothing, so a deployment cannot
# leak task identifiers to a third party by accident.
# ALERTING_ENABLED=false
#
# The webhook. Treated as a secret: incoming-webhook URLs for Slack, PagerDuty
# and most receivers embed a live token in the path, so this value is never
# logged, never echoed into a payload, and never quoted in an error message.
# Must be https in production - the payload names a tenant and a task, and
# plaintext http discloses that to every hop on the path.
# ALERT_WEBHOOK_URL=https://hooks.example.com/services/T000/B000/XXXX
#
# Short, because the alert is sent inline with a state transition that holds a
# row lock. A slow receiver must not hold that lock open.
# ALERT_TIMEOUT_SECONDS=5.0
