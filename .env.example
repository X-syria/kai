# Copy to .env and adjust. Never commit .env.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Postgres connection used by the application (asyncpg dialect)
DATABASE_URL=postgresql+asyncpg://kai:kai@127.0.0.1:5432/kai

# Postgres container settings (docker compose)
POSTGRES_USER=kai
POSTGRES_PASSWORD=kai
POSTGRES_DB=kai
POSTGRES_PORT=5432

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_ACCESS_TOKEN_MINUTES=120